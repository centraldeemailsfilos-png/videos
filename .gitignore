# segredos
.env

# material bruto e saídas de edição — pesados, ficam fora do git
footage/*
!footage/.gitkeep
edit/*
!edit/.gitkeep
# decisoes de corte e memoria do projeto sao versionadas (leves e valiosas);
# a midia nao
!edit/project.md
!edit/edl.json
!edit/analysis
edit/analysis/*
!edit/analysis/*.json

# mídia solta em qualquer lugar
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wav
*.mp3
*.m4a
*.aac
!.claude/skills/**/*.mp4
!.claude/skills/**/*.webm

# node / python
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.uv/
!edit/angola
edit/angola/*
!edit/angola/analysis
edit/angola/analysis/*
!edit/angola/analysis/*.json
!edit/angola/project.md
!edit/angola/animations
edit/angola/animations/*
!edit/angola/animations/p3_trajetoria
!edit/angola/animations/p6_maes
edit/angola/animations/p3_trajetoria/*
edit/angola/animations/p6_maes/*
!edit/angola/animations/*/index.html
!edit/angola/animations/c0_abertura
!edit/angola/animations/c1_portao
!edit/angola/animations/c3_educacao
!edit/angola/animations/c5_equipe
!edit/angola/animations/c6_barriga
!edit/angola/animations/c7_valor
!edit/angola/animations/c8_prato
!edit/angola/animations/c9_logo
edit/angola/animations/c0_abertura/*
edit/angola/animations/c1_portao/*
edit/angola/animations/c3_educacao/*
edit/angola/animations/c5_equipe/*
edit/angola/animations/c6_barriga/*
edit/angola/animations/c7_valor/*
edit/angola/animations/c8_prato/*
edit/angola/animations/c9_logo/*
