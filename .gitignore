# segredos
.env

# material bruto e saídas de edição — pesados, ficam fora do git
footage/*
!footage/.gitkeep
edit/*
!edit/.gitkeep
# decisoes de corte e memoria do projeto sao versionadas (leves e valiosas);
# a midia nao
!edit/project.md
!edit/edl.json
!edit/analysis
edit/analysis/*
!edit/analysis/*.json

# mídia solta em qualquer lugar
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wav
*.mp3
*.m4a
*.aac
!.claude/skills/**/*.mp4
!.claude/skills/**/*.webm

# node / python
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.uv/
!edit/angola
edit/angola/*
!edit/angola/analysis
edit/angola/analysis/*
!edit/angola/analysis/*.json
!edit/angola/project.md
